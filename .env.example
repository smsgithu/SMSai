# Copy to .env for local API work. Do not commit real values.
# Vercel already provides the database URL and the Anthropic key in the hosted project.
# This phase does not change those production settings.

ANTHROPIC_API_KEY=
POSTGRES_URL=

# Discord help tickets. Leave this blank until a webhook exists.
# It must be an https://discord.com/api/webhooks/... or discordapp.com webhook.
# If it is missing or not a Discord webhook, Get Help says help is not connected and sends nothing.
DISCORD_TICKET_WEBHOOK=

# One-time leaderboard reset. Leave both unset.
# Setting the flag does not reset anything by itself. See README for the launch command.
# Do not turn this on for a preview that shares the production database.
# LEADERBOARD_LAUNCH_RESET=confirm
# LEADERBOARD_LAUNCH_RESET_SECRET=
